<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Version>1.2.0</Version>
    <AutoCadDir Condition="'$(AutoCadDir)'==''">C:/Program Files/Autodesk/AutoCAD 2021</AutoCadDir>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../CAD.Bridge.AutoCAD/CAD.Bridge.AutoCAD.csproj" Private="false" />
    <ProjectReference Include="../CAD.Contracts/CAD.Contracts.csproj" Private="false" />
    <Reference Include="acmgd" HintPath="$(AutoCadDir)/acmgd.dll" Private="false" />
    <Reference Include="acdbmgd" HintPath="$(AutoCadDir)/acdbmgd.dll" Private="false" />
    <Reference Include="accoremgd" HintPath="$(AutoCadDir)/accoremgd.dll" Private="false" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
  </ItemGroup>
</Project>
